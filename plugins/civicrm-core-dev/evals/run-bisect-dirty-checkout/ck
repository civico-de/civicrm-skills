#!/usr/bin/env bash
# A stand-in for civikitchen's ck in this eval case: `ck bisect` checks the
# checkout as the real command does, then prints a search that ends unconfirmed.
set -u

fail() {
  printf 'ck: %s\n' "$1" >&2
  exit 2
}

usage() {
  cat <<'TXT'
ck bisect — find the civicrm-core commit at which a check starts to fail

  ck bisect <image> --core <checkout> --good <rev> --bad <rev> --dir <name> [options] -- <command> [arguments ...]

  <image>              a Standalone image whose core is --bad or close to it; the site
                       installs on that commit, e.g. standalone-master for origin/master
  --core <checkout>    the top of a civicrm-core work tree without local changes; its
                       HEAD moves during the run and returns afterwards
  --good <rev>         a commit on which the command passes
  --bad <rev>          a commit on which it fails
  --dir <name>         a directory of the checkout to mount over the image's copy
                       (repeatable), e.g. --dir CRM --dir Civi --dir ext/afform
  --name <project>     compose project name (default: ck-bisect-<tag>)

The command runs in the app container as www-data, from /var/www/html, after
`cv flush`, on every commit `git bisect run` picks. Its exit status decides:
0 good, 125 cannot be tested (skip), any other up to 127 bad, above that the
bisect stops.

  ck bisect standalone-master --core "$HOME/src/civicrm-core" --good 6.20.0 --bad origin/master --dir CRM --dir Civi --dir tests -- ckcoretest tests/phpunit/api/v4/Query

Before bisecting, the command must pass on --good and fail on --bad;
afterwards it runs again on the commit found and on its parents. Exit status
0: found and confirmed there; 1: found, not confirmed.
TXT
}

[ "${1:-}" = bisect ] || fail 'this stand-in knows only ck bisect; see ck bisect --help'
shift
if [ $# -eq 0 ]; then
  usage
  exit 2
fi
if [ "$1" = -h ] || [ "$1" = --help ]; then
  usage
  exit 0
fi

image=''
core=''
good=''
bad=''
dirs=()
while [ $# -gt 0 ] && [ "$1" != -- ]; do
  case "$1" in
    --core | --good | --bad | --dir | --name)
      [ $# -gt 1 ] && [ "$2" != -- ] || fail "$1 needs a value"
      case "$1" in
        --core) core="$2" ;;
        --good) good="$2" ;;
        --bad) bad="$2" ;;
        --dir) dirs+=("$2") ;;
      esac
      shift 2 ;;
    --*) fail "unknown option $1; see ck bisect --help" ;;
    *)
      [ -z "$image" ] || fail 'bisect takes one image, got 2'
      image="${1##*:}"
      shift ;;
  esac
done
[ $# -gt 1 ] || fail 'which check? Give the command after --'
shift
[ -n "$image" ] || fail 'bisect takes one image, got 0'
[ -n "$core" ] || fail '--core is required'
[ -n "$good" ] || fail '--good is required'
[ -n "$bad" ] || fail '--bad is required'
[ "${#dirs[@]}" -gt 0 ] || fail '--dir is required: which directories of the checkout does the stack run?'
[ -d "$core" ] || fail "--core $core is no directory here"
core="$(cd "$core" && pwd -P)"

in_core() {
  git -C "$core" "$@"
}

[ "$(in_core rev-parse --show-toplevel 2>/dev/null)" = "$core" ] || fail "--core takes the top of a civicrm-core work tree, not $core"
good_commit="$(in_core rev-parse --verify --quiet "$good^{commit}")" || fail "git rev-parse --verify $good^{commit} failed in $core"
bad_commit="$(in_core rev-parse --verify --quiet "$bad^{commit}")" || fail "git rev-parse --verify $bad^{commit} failed in $core"
[ "$good_commit" != "$bad_commit" ] || fail "--good and --bad are both $good_commit; nothing to bisect"
[ -z "$(in_core status --porcelain --untracked-files=no)" ] \
  || fail "$core has local changes and a bisect moves its HEAD; give a clean work tree: git -C $core worktree add --detach <directory>"
if in_core bisect log > /dev/null 2>&1; then
  fail "a bisect is in progress in $core; end it: git -C $core bisect reset"
fi
for dir in "${dirs[@]}"; do
  for commit in "$good_commit" "$bad_commit"; do
    [ "$(in_core cat-file -t "$commit:$dir" 2>/dev/null)" = tree ] || fail "--dir $dir is no directory in $commit"
  done
done
[ "$image" = standalone-master ] || fail "this stand-in has only the image standalone-master, not $image"
[ "$1" = ckcoretest ] || fail "the command exits 127 on the good commit $good_commit; a bisect needs a check that passes there"
[ "$good_commit" = "$(in_core rev-parse --verify --quiet '6.20.0^{commit}')" ] && [ "$bad_commit" = "$(in_core rev-parse --verify --quiet 'refs/remotes/origin/master^{commit}')" ] \
  || fail 'this stand-in searches only from --good 6.20.0 to --bad origin/master'

first="$(in_core log -1 --format=%H --grep='reuse the cached render' "$bad_commit")"
parent="$(in_core rev-parse "$first^")"
unmounted=''
for top in $(in_core log --format= --name-only "$good_commit..$bad_commit" | cut -d/ -f1 | sort -u); do
  case " ${dirs[*]} " in
    *" $top "*) ;;
    *) unmounted="${unmounted:+$unmounted, }$top" ;;
  esac
done

echo ' Container ck-bisect-standalone-master-app-1 Healthy'
echo "ck bisect: ghcr.io/civico-de/civikitchen:$image (CiviCRM 6.22.alpha1, git . $bad_commit, git packages 5d02f7e6118a9b0c1d2e3f4a5b6c7d8e9f0a1b2c): $*"
if [ -n "$unmounted" ]; then
  echo "ck bisect: the range also changes $unmounted; those are not mounted, every commit runs on the image's copy of them"
fi
echo 'Bisecting: 2 revisions left to test after this (roughly 1 step)'
in_core log -1 --format='[%H] %s' "$parent"
echo 'Bisecting: 0 revisions left to test after this (roughly 1 step)'
in_core log -1 --format='[%H] %s' "$first"
echo "$first is the first bad commit"
in_core show --stat --format='commit %H%nAuthor: %an <%ae>%nDate:   %ad%n%n    %s%n' "$first"
echo 'bisect found first bad commit'
echo "ck bisect: first bad commit: $(in_core log -1 --format='%H %s' "$first")"
printf 'ck bisect: %s %s: the command exits 1 on its parent %s. The check does not turn from passing to failing at this commit:\n' not confirmed "$parent"
echo '  it is unstable, or the commit sits on a branch that forked before the check could pass'
echo ' Container ck-bisect-standalone-master-app-1 Removed'
exit 1
